# Public Supabase project URL and publishable (or legacy anon) key only.
# Never use a secret/service_role key here. No server secrets needed in V20.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only sandbox configuration; default disabled. Never prefix secrets with NEXT_PUBLIC_.
AMPLOP_SANDBOX_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
MIDTRANS_SANDBOX_SERVER_KEY=
AMPLOP_SANDBOX_PRICE_IDR=
